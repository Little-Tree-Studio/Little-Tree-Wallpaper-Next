LangString LTW_ERR_X64 ${LANG_SIMPCHINESE} "小树壁纸 Next 需要 64 位 Windows 系统。"
LangString LTW_ERR_X64 ${LANG_ENGLISH}     "Little Tree Wallpaper Next requires 64-bit Windows."
