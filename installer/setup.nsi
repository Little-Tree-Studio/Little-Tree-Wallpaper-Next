; ============================================================================
; Little Tree Wallpaper Next - NSIS installer (Modern UI 2, multilingual)
;
; Languages : Simplified Chinese / English / Traditional Chinese / Japanese
; Branding  : header + welcome bitmaps and icon are generated by tools/build.py
; Versioning: APP_VERSION (display) / FILE_VERSION (numeric X.X.X.X for
;             VIProductVersion) / BUILD_CHANNEL / SOURCE_DIR / OUT_FILE /
;             ASSETS_DIR are injected via makensis /D defines; do not hardcode
;             them here.
; ============================================================================

Unicode true
ManifestDPIAware true
SetCompressor /SOLID lzma
SetCompressorDictSize 64

!ifndef APP_VERSION
  !define APP_VERSION "2.0.0"
!endif
; VIProductVersion requires a strictly numeric X.X.X.X value and rejects
; prerelease suffixes. tools/build.py always injects FILE_VERSION derived from
; APP_VERSION (prerelease dropped, zero-padded to four segments). This fallback
; keeps plain numeric versions working when compiling setup.nsi directly.
!ifndef FILE_VERSION
  !define FILE_VERSION "${APP_VERSION}.0"
!endif
!ifndef BUILD_CHANNEL
  !define BUILD_CHANNEL "beta"
!endif
!ifndef SOURCE_DIR
  !error "SOURCE_DIR must point at the PyInstaller onedir bundle"
!endif
!ifndef ASSETS_DIR
  !error "ASSETS_DIR must point at the generated installer assets"
!endif
!ifndef LICENSE_FILE
  !define LICENSE_FILE "..\LICENSES"
!endif
!ifndef OUT_FILE
  !define OUT_FILE "LittleTreeWallpaper-Setup.exe"
!endif
!ifndef OUT_NAME
  !define OUT_NAME "LittleTreeWallpaper-Setup.exe"
!endif

!define PRODUCT_ID            "LittleTreeWallpaper"
!define PRODUCT_EXE           "LittleTreeWallpaper.exe"
!define PRODUCT_UNINSTALL_EXE "Uninstall.exe"
!define PRODUCT_PUBLISHER     "LittleTreeStudio"
!define PRODUCT_WEBSITE       "https://github.com/Little-Tree-Studio/Little-Tree-Wallpaper-Next"
!define PRODUCT_REG_KEY       "Software\LittleTreeStudio\LittleTreeWallpaper"
!define PRODUCT_UNINST_KEY    "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_ID}"

Name "$(LTW_NAME)"
OutFile "${OUT_FILE}"
InstallDir "$PROGRAMFILES64\${PRODUCT_ID}"
InstallDirRegKey HKLM "${PRODUCT_REG_KEY}" "InstallDir"
RequestExecutionLevel admin
ShowInstDetails show
ShowUnInstDetails show
AllowSkipFiles off
BrandingText "Little Tree Wallpaper Next"

VIProductVersion "${FILE_VERSION}"
VIAddVersionKey "ProductName"      "Little Tree Wallpaper Next"
VIAddVersionKey "CompanyName"      "${PRODUCT_PUBLISHER}"
VIAddVersionKey "FileVersion"      "${FILE_VERSION}"
VIAddVersionKey "ProductVersion"   "${APP_VERSION}"
VIAddVersionKey "FileDescription"  "Little Tree Wallpaper Next Setup"
VIAddVersionKey "LegalCopyright"   "GNU Affero General Public License v3.0"
VIAddVersionKey "OriginalFilename" "${OUT_NAME}"

!include "MUI2.nsh"
!include "FileFunc.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"

; ------------------------------ UI appearance ------------------------------
!define MUI_ABORTWARNING
!define MUI_ICON   "${ASSETS_DIR}\logo.ico"
!define MUI_UNICON "${ASSETS_DIR}\logo.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_HEADERIMAGE_BITMAP "${ASSETS_DIR}\header.bmp"
!define MUI_WELCOMEFINISHPAGE_BITMAP   "${ASSETS_DIR}\welcome.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "${ASSETS_DIR}\welcome.bmp"
!define MUI_WELCOMEPAGE_TITLE_3LINES
!define MUI_FINISHPAGE_TITLE_3LINES
!define MUI_FINISHPAGE_RUN "$INSTDIR\${PRODUCT_EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "$(LTW_FINISH_RUN)"
!define MUI_FINISHPAGE_LINK "$(LTW_FINISH_LINK)"
!define MUI_FINISHPAGE_LINK_LOCATION "${PRODUCT_WEBSITE}"
!define MUI_LANGDLL_REGISTRY_ROOT "HKLM"
!define MUI_LANGDLL_REGISTRY_KEY "${PRODUCT_REG_KEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "InstallerLanguage"

; --------------------- Per-language UI font optimization ---------------------
; The stock dialog font (MS Shell Dlg -> SimSun for Chinese) renders poorly.
; Instead, every control's font is cloned at runtime with a modern face
; (Microsoft YaHei / Segoe UI / Microsoft JhengHei / Yu Gothic UI) while
; keeping the original size and weight, so dialog layouts stay intact.
!define MUI_CUSTOMFUNCTION_GUIINIT   "InitInstallerFont"
!define MUI_CUSTOMFUNCTION_UNGUIINIT "un.InitInstallerFont"

Var FontDPI
Var UpdatePid
Var LaunchAfterUpdate

!macro LTW_FONT_FUNCTIONS un
  Function ${un}ApplyFontToChildren
    ; $R9 = parent window whose direct children receive the new font face
    Push $R0
    Push $R4
    Push $R5
    Push $R6
    Push $R7
    Push $R8
    System::Call "user32::GetWindow(p $R9, i 5) p.s" ; GW_CHILD
    Pop $R8
    ${While} $R8 <> 0
      SendMessage $R8 ${WM_GETFONT} 0 0 $R7
      ${If} $R7 <> 0
        System::Call "gdi32::GetObjectW(p $R7, i 92, @R6)"
        System::Call "*$R6(i.R0, i, i, i, i.R5)" ; lfHeight (px), lfWeight
        ; The CreateFont instruction takes POINTS, not pixels: it applies
        ; -MulDiv(pt, GetDeviceCaps(LOGPIXELSY), 72) internally. Feed it the
        ; pixel height converted back to points or fonts get scaled twice.
        ${If} $R0 < 0
          IntOp $R0 $R0 * -1
        ${EndIf}
        IntOp $R0 $R0 * 72
        IntOp $R0 $R0 / $FontDPI
        ${If} $R0 < 1
          StrCpy $R0 1
        ${EndIf}
        CreateFont $R4 "$(LTW_FONT_FACE)" $R0 $R5
        SendMessage $R8 ${WM_SETFONT} $R4 1
      ${EndIf}
      System::Call "user32::GetWindow(p $R8, i 2) p.s" ; GW_HWNDNEXT
      Pop $R8
    ${EndWhile}
    Pop $R8
    Pop $R7
    Pop $R6
    Pop $R5
    Pop $R4
    Pop $R0
  FunctionEnd

  Function ${un}ApplyFontsDeep
    ; Restyle the outer dialog plus every embedded page dialog. Both classic
    ; MUI pages and nsDialogs pages (welcome/finish) live somewhere inside the
    ; child tree of $HWNDPARENT, and a previous page's dialog may still exist
    ; during a transition, so every level is swept instead of FindWindow.
    Push $R8
    System::Call "user32::GetDC(p $HWNDPARENT) p.s"
    Pop $R8
    System::Call "gdi32::GetDeviceCaps(p $R8, i 90) i.s" ; LOGPIXELSY
    Pop $FontDPI
    System::Call "user32::ReleaseDC(p $HWNDPARENT, p $R8)"
    ${If} $FontDPI < 96
      StrCpy $FontDPI 96
    ${EndIf}
    StrCpy $R9 $HWNDPARENT
    Call ${un}ApplyFontToChildren
    System::Call "user32::GetWindow(p $HWNDPARENT, i 5) p.s" ; GW_CHILD
    Pop $R8
    ${While} $R8 <> 0
      StrCpy $R9 $R8
      Call ${un}ApplyFontToChildren
      System::Call "user32::GetWindow(p $R8, i 2) p.s" ; GW_HWNDNEXT
      Pop $R8
    ${EndWhile}
    Pop $R8
  FunctionEnd

  Function ${un}InitInstallerFont
    Call ${un}ApplyFontsDeep
  FunctionEnd

  Function ${un}PageFontShow
    Call ${un}ApplyFontsDeep
  FunctionEnd
!macroend
!insertmacro LTW_FONT_FUNCTIONS ""
!insertmacro LTW_FONT_FUNCTIONS "un."

; --------------------------------- Pages -----------------------------------
