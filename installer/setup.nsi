; ------------------- Shared "app still running" guard ----------------------
!macro LTW_ENSURE_APP_CLOSED un
  Function ${un}EnsureAppClosed
    ${If} ${FileExists} "$INSTDIR\${PRODUCT_EXE}"
      ${un}close_retry:
        ClearErrors
        Delete "$INSTDIR\${PRODUCT_EXE}"
        ${If} ${Errors}
          IfSilent ${un}silent_abort 0
          MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$(LTW_ERR_RUNNING)" /SD IDRETRY IDRETRY ${un}close_retry
          Abort
          ${un}silent_abort:
            SetErrorLevel 2
            Abort
        ${EndIf}
    ${EndIf}
  FunctionEnd
!macroend
!insertmacro LTW_ENSURE_APP_CLOSED ""
!insertmacro LTW_ENSURE_APP_CLOSED "un."

; --------------------------------- Init ------------------------------------
Function .onInit
  StrCpy $UpdatePid ""
  StrCpy $LaunchAfterUpdate "0"
  ${GetParameters} $R0
  ClearErrors
  ${GetOptions} $R0 "/UPDATEPID=" $UpdatePid
  ClearErrors
  ${GetOptions} $R0 "/LAUNCH=" $LaunchAfterUpdate
  ${If} $UpdatePid != ""
    System::Call "kernel32::OpenProcess(i 0x00100000, i 0, i $UpdatePid) p.r0"
    ${If} $0 P<> 0
      ; Wait for the running application to release installed files. A finite
      ; timeout prevents an invisible silent updater from hanging forever.
      System::Call "kernel32::WaitForSingleObject(p r0, i 120000) i.r1"
      System::Call "kernel32::CloseHandle(p r0)"
    ${EndIf}
  ${EndIf}
  !insertmacro MUI_LANGDLL_DISPLAY
  ${IfNot} ${RunningX64}
    MessageBox MB_ICONSTOP "$(LTW_ERR_X64)" /SD IDOK
    Abort
  ${EndIf}
FunctionEnd

Function un.onInit
  !insertmacro MUI_UNGETLANGUAGE
FunctionEnd

; -------------------------------- Sections ---------------------------------
Section "$(LTW_SEC_MAIN)" SecMain
  SectionIn RO
  SetOutPath "$INSTDIR"

  Call EnsureAppClosed
  RMDir /r "$INSTDIR"

  File /r "${SOURCE_DIR}\*.*"

  WriteUninstaller "$INSTDIR\${PRODUCT_UNINSTALL_EXE}"

  WriteRegStr HKLM "${PRODUCT_REG_KEY}" "InstallDir" "$INSTDIR"
  WriteRegStr HKLM "${PRODUCT_REG_KEY}" "ShortcutName" "$(LTW_NAME)"
  WriteRegStr HKLM "${PRODUCT_REG_KEY}" "UninstallShortcutName" "$(LTW_UNINSTALL)"

  WriteRegStr   HKLM "${PRODUCT_UNINST_KEY}" "DisplayName"     "$(LTW_NAME)"
  WriteRegStr   HKLM "${PRODUCT_UNINST_KEY}" "DisplayVersion"  "${APP_VERSION}"
  WriteRegStr   HKLM "${PRODUCT_UNINST_KEY}" "Publisher"       "${PRODUCT_PUBLISHER}"
  WriteRegStr   HKLM "${PRODUCT_UNINST_KEY}" "URLInfoAbout"    "${PRODUCT_WEBSITE}"
  WriteRegStr   HKLM "${PRODUCT_UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr   HKLM "${PRODUCT_UNINST_KEY}" "DisplayIcon"     "$INSTDIR\${PRODUCT_EXE},0"
  WriteRegStr   HKLM "${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\${PRODUCT_UNINSTALL_EXE}"
  WriteRegDWORD HKLM "${PRODUCT_UNINST_KEY}" "NoModify"  1
  WriteRegDWORD HKLM "${PRODUCT_UNINST_KEY}" "NoRepair"  1
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  WriteRegDWORD HKLM "${PRODUCT_UNINST_KEY}" "EstimatedSize" $0

  CreateDirectory "$SMPROGRAMS\$(LTW_NAME)"
  CreateShortcut  "$SMPROGRAMS\$(LTW_NAME)\$(LTW_NAME).lnk" "$INSTDIR\${PRODUCT_EXE}" "" "$INSTDIR\${PRODUCT_EXE}" 0
  CreateShortcut  "$SMPROGRAMS\$(LTW_NAME)\$(LTW_UNINSTALL).lnk" "$INSTDIR\${PRODUCT_UNINSTALL_EXE}"
SectionEnd

Section "$(LTW_SEC_DESKTOP)" SecDesktop
  CreateShortcut "$DESKTOP\$(LTW_NAME).lnk" "$INSTDIR\${PRODUCT_EXE}" "" "$INSTDIR\${PRODUCT_EXE}" 0
SectionEnd

Function .onInstSuccess
  ${If} $LaunchAfterUpdate == "1"
    Exec '"$INSTDIR\${PRODUCT_EXE}"'
  ${EndIf}
FunctionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SecMain}    "$(LTW_SEC_MAIN_DESC)"
  !insertmacro MUI_DESCRIPTION_TEXT ${SecDesktop} "$(LTW_SEC_DESKTOP_DESC)"
!insertmacro MUI_FUNCTION_DESCRIPTION_END

; ------------------------------- Uninstall ---------------------------------
Section "Uninstall"
  Call un.EnsureAppClosed

  ReadRegStr $0 HKLM "${PRODUCT_REG_KEY}" "ShortcutName"
  ${If} $0 == ""
    StrCpy $0 "Little Tree Wallpaper Next"
  ${EndIf}
  ReadRegStr $1 HKLM "${PRODUCT_REG_KEY}" "UninstallShortcutName"
  ${If} $1 == ""
    StrCpy $1 "Uninstall Little Tree Wallpaper Next"
  ${EndIf}

  Delete "$DESKTOP\$0.lnk"
  Delete "$SMPROGRAMS\$0\$0.lnk"
  Delete "$SMPROGRAMS\$0\$1.lnk"
  RMDir  "$SMPROGRAMS\$0"

  RMDir /r "$INSTDIR"

  DeleteRegKey HKLM "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKLM "${PRODUCT_REG_KEY}"
SectionEnd
